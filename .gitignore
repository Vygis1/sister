# --- build products -------------------------------------------------------
build/
.Xil/
xsim.dir/
*.jou
*.log
*.pb
*.str

# Vivado leaves these in the project root
FinalUnmatchedCellsToUnplace.txt
clockInfo.txt
tight_setup_hold_pins.txt
psipCongestionLevel.txt
/--list

# --- bitstreams -----------------------------------------------------------
# Each is a few megabytes and every one is reproducible from the sources here.
# cores/known-good/ is the set worth keeping on THIS machine as somewhere to
# fall back to when a build will not come up; it is not worth 130 MB of history.
cores/
prebuilt/*.bit
*.bit
*.bin
*.mcs

# --- other people's copyrighted data --------------------------------------
# sim/roms holds a converted Sony PlayStation BIOS and console test ROMs, and
# the disc images live outside the tree entirely. None of it is ours to publish.
sim/roms/

# --- vendored third-party tools -------------------------------------------
# arduino-cli is 37 MB and comes from its own project.
tools/arduino/

# --- python --------------------------------------------------------------
__pycache__/
*.pyc

# --- things a session leaves lying around ----------------------------------
# Java crash dumps from Vivado, screenshots dropped in the root
hs_err_pid*
*.dmp
/*.png

# --- your own data -----------------------------------------------------------
# memory card images and backups
saves/
*.mcr
*.mcr.bak


# --- releases -----------------------------------------------------------------
# tools/release.sh builds these from cores/ and the commit
dist/

# N64 bench inputs and outputs, generated from test ROMs (tools/n64/n64sim.py)
sim/n64/
sim/n64b/
sim/n64r/
sim/n64d/
tools/menu_preview/cut.h
sim/vid/

# PC-core simulation output (Verilator), generated bench data
sim/pc/obj*/
sim/pc/frames/
sim/pc/cdtest
sim/pc/*.mem
sim/hdmi_syms.txt
sim/n64r*/
sim/ps1mdec/

# z486 ROM images: recovered Intel 80386 data, not licensed for redistribution
# (docs/THIRD_PARTY.md); tools/pc/fetch_z486.sh downloads them from upstream
rtl/pc/z486/*.mem

# private notes, agent worktrees
outreach/
.claude/
