# Settings for this machine. Copy to local.env (which git ignores) and edit.
# pc/fpgalink.py reads it, so the server and every tool see these; a real
# environment variable of the same name wins.

# the board, as set in rtl/eth_top.v (IP_ADDR)
FPGA_HOST=192.168.178.50

# your own PlayStation BIOS dump: the server puts it back after a console reset
#PS1_BIOS=/path/to/SCPH1001.BIN

# the memory card file (default saves/card1.mcr)
#PS1_CARD=/path/to/card1.mcr

# the ESP32 front door, if you have one
#ESP_HOST=192.168.178.94
